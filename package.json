{
  "name": "wasmtts-benchmark",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build:matcha-kaldifst": "platform/kaldifst-wasm/build.sh",
    "vendor:mobile": "node scripts/vendor-mobile.mjs",
    "fetch:matcha-assets": "node scripts/fetch-matcha-assets.mjs",
    "host:mobile": "pnpm vendor:mobile && node mobile-host/server.mjs",
    "host:score": "WASM_TTS_SCORE_ONLY=1 node mobile-host/server.mjs",
    "fetch:breeze2-vits-assets": "node scripts/fetch-breeze2-vits-assets.mjs",
    "benchmark:vits": "node platform/run-vits-browser.mjs",
    "benchmark:kokoro": "node platform/run-kokoro-browser.mjs",
    "benchmark:breeze2-vits": "node platform/run-breeze2-vits-browser.mjs",
    "benchmark:matcha": "node platform/run-matcha-browser.mjs",
    "benchmark:matcha-product": "WASM_TTS_SYNTHESIS_PROFILE=product node platform/run-matcha-browser.mjs",
    "benchmark:matcha-upstream-fst": "node platform/run-matcha-upstream-fst-browser.mjs",
    "benchmark:matcha-fst-ab": "node platform/run-matcha-fst-ab-browser.mjs",
    "benchmark:matcha-stream": "pnpm vendor:mobile && node platform/run-matcha-stream-browser.mjs",
    "audit:matcha-g2p": "node platform/audit-matcha-g2p.mjs",
    "audit:matcha-g2pw-pilot": "UV_OFFLINE=1 HF_HOME=platform/models/g2pw/hf TRANSFORMERS_OFFLINE=1 HF_HUB_OFFLINE=1 uv run --with g2pw==0.1.1 --with requests==2.32.5 --with torch==2.13.0 --with onnxruntime==1.28.0 --with transformers==5.15.0 platform/run-g2pw-pilot.py",
    "fixture:matcha-g2pw-webgpu": "HF_HOME=platform/models/g2pw/hf TRANSFORMERS_OFFLINE=1 HF_HUB_OFFLINE=1 uv run --with g2pw==0.1.1 --with requests==2.32.5 --with torch==2.13.0 --with onnxruntime==1.28.0 --with transformers==5.15.0 platform/generate-g2pw-webgpu-fixture.py",
    "benchmark:matcha-g2pw-webgpu": "node platform/run-g2pw-webgpu-browser.mjs",
    "index:matcha-g2pw-webgpu-fixture": "node platform/index-g2pw-webgpu-fixture.mjs",
    "index:matcha-g2pw-webgpu": "node platform/index-matcha-g2pw-webgpu.mjs",
    "g2pw-index": "node platform/manage-matcha-g2pw-index.mjs",
    "g2pw-review": "node platform/manage-matcha-g2pw-review.mjs",
    "test:matcha-g2pw-index": "node platform/test-g2pw-index-db.mjs",
    "report:matcha-g2p-roi": "node platform/rank-matcha-g2p-roi.mjs",
    "report:matcha-g2pw-sqlite-roi": "node platform/report-matcha-g2pw-sqlite-roi.mjs",
    "test:matcha-frontend": "node platform/test-matcha-frontend.mjs",
    "generate:matcha-lexicon-traditional": "node platform/generate-matcha-lexicon-traditional.mjs",
    "test:matcha-lexicon-traditional": "node platform/test-matcha-lexicon-traditional.mjs",
    "test:matcha-g2p-review": "node platform/test-matcha-g2p-review.mjs",
    "test:matcha-g2p-roi": "node platform/test-matcha-g2p-roi.mjs",
    "test:matcha-g2pw-sqlite-roi": "node platform/test-matcha-g2pw-sqlite-roi.mjs",
    "test:matcha-taiwan-profile": "node platform/test-matcha-taiwan-profile.mjs",
    "test:matcha-fst": "node platform/test-matcha-fst.mjs",
    "test:matcha-fst:tables": "MATCHA_FST_DIR=platform/models/matcha-icefall-zh-en node platform/test-matcha-fst.mjs",
    "test:matcha-kaldifst-wasm": "node platform/test-kaldifst-wasm-browser.mjs",
    "test:matcha-asr": "uv run platform/asr-listening-gate.py --audio platform/results/matcha_icefall_zh_en-browser-wasm.wav --expected-file frameworks/matcha/samples/quality.txt --absolute-cer-limit 0.08 --baseline-report platform/asr-baseline/current.json --regression-tolerance 0.02 --output platform/results/asr-listening-report.json",
    "test:matcha-asr-product": "uv run platform/asr-listening-gate.py --audio platform/results/matcha_icefall_zh_en-product-browser-wasm.wav --expected-file frameworks/matcha/samples/quality.txt --absolute-cer-limit 0.08 --baseline-report platform/asr-baseline/product.json --regression-tolerance 0.02 --output platform/results/asr-listening-product-report.json",
    "test:release-gates": "node scripts/run-release-gates.mjs",
    "generate:release-md": "node scripts/generate-release-md.mjs",
    "validate:release-results": "node scripts/validate-release-results.mjs",
    "sample:matcha-upstream-fst-traditional": "node platform/generate-matcha-upstream-fst-traditional-sample.mjs",
    "sample:matcha-frequency-ab": "pnpm vendor:mobile && node platform/generate-matcha-frequency-ab.mjs",
    "sample:matcha-stream": "pnpm vendor:mobile && node platform/generate-matcha-stream-sample.mjs"
  },
  "dependencies": {
    "lamejs": "1.2.1",
    "onnxruntime-web": "1.27.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "opencc-js": "1.4.1",
    "playwright-core": "^1.62.1",
    "sherpa-onnx": "1.13.4"
  }
}
