{
  "name": "wasmtts-benchmark",
  "private": true,
  "type": "commonjs",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build:matcha-kaldifst": "platform/kaldifst-wasm/build.sh",
    "vendor:mobile": "node scripts/vendor-mobile.mjs",
    "fetch:matcha-assets": "node scripts/fetch-matcha-assets.mjs",
    "host:mobile": "pnpm vendor:mobile && node mobile-host/server.mjs",
    "host:score": "WASM_TTS_SCORE_ONLY=1 node mobile-host/server.mjs",
    "fetch:breeze2-vits-assets": "node scripts/fetch-breeze2-vits-assets.mjs",
    "benchmark:vits": "node platform/run-vits-browser.mjs",
    "benchmark:kokoro": "node platform/run-kokoro-browser.mjs",
    "benchmark:breeze2-vits": "node platform/run-breeze2-vits-browser.mjs",
    "benchmark:matcha": "node platform/run-matcha-browser.mjs",
    "benchmark:matcha-upstream-fst": "node platform/run-matcha-upstream-fst-browser.mjs",
    "benchmark:matcha-fst-ab": "node platform/run-matcha-fst-ab-browser.mjs",
    "benchmark:matcha-stream": "pnpm vendor:mobile && node platform/run-matcha-stream-browser.mjs",
    "test:matcha-frontend": "node platform/test-matcha-frontend.mjs",
    "test:matcha-fst": "node platform/test-matcha-fst.mjs",
    "test:matcha-fst:tables": "MATCHA_FST_DIR=platform/models/matcha-icefall-zh-en node platform/test-matcha-fst.mjs",
    "test:matcha-kaldifst-wasm": "node platform/test-kaldifst-wasm-browser.mjs",
    "test:matcha-asr": "uv run platform/asr-listening-gate.py --audio platform/results/matcha_icefall_zh_en-browser-wasm.wav --expected-file frameworks/matcha/samples/quality.txt --absolute-cer-limit 0.08 --baseline-report platform/asr-baseline/current.json --regression-tolerance 0.02 --output platform/results/asr-listening-report.json",
    "test:release-gates": "node scripts/run-release-gates.mjs",
    "validate:release-results": "node scripts/validate-release-results.mjs",
    "sample:matcha-upstream-fst-traditional": "node platform/generate-matcha-upstream-fst-traditional-sample.mjs",
    "sample:matcha-frequency-ab": "pnpm vendor:mobile && node platform/generate-matcha-frequency-ab.mjs",
    "sample:matcha-stream": "pnpm vendor:mobile && node platform/generate-matcha-stream-sample.mjs"
  },
  "dependencies": {
    "lamejs": "1.2.1",
    "onnxruntime-web": "1.27.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "opencc-js": "1.4.1",
    "playwright-core": "^1.62.1",
    "sherpa-onnx": "1.13.4"
  }
}
